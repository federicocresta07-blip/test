{
  "name": "match-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Motor de simulacion de partidos de futbol (sin simulacion visual) para juego de management",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.ui.json && tsc --noEmit -p tsconfig.browser-tests.json",
    "calibrate": "node scripts/calibrate.ts",
    "demo": "node scripts/demo.ts",
    "season": "node scripts/season.ts",
    "clausura98": "node scripts/clausura-1998.ts",
    "torneo": "node scripts/torneo.ts",
    "crests": "node scripts/crests.mjs",
    "import:planteles": "node scripts/import-squads.mjs",
    "apertura98": "node scripts/gen-apertura98.mjs",
    "single": "npm run build && node scripts/single-html.mjs",
    "test:ui": "node --test \"tests-browser/**/*.test.ts\"",
    "serve": "node scripts/server.ts",
    "build:api": "vite build --config vite.config.api.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/migrate-deploy.ts",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "vercel-build": "npm run db:validate && npm run db:generate && npm run db:deploy && npm run build && npm run build:api",
    "postinstall": "prisma generate",
    "password": "node scripts/password.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "prisma": "^7.10.0",
    "typescript": "^5.9.0",
    "vite": "7.3.6"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
